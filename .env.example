# Discord bot token: https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=

# Last.fm API key: https://www.last.fm/api/account/create
LASTFM_API_KEY=

# Optional: your server's ID. Slash commands show up instantly in this server
# (otherwise global commands can take up to an hour to appear).
GUILD_ID=
